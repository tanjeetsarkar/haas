# Copy to .env (the development Compose overlay reads it automatically)
HAAS_PROFILE=dev
OPENROUTER_API_KEY=sk-or-v1-replace-me
DEFAULT_PRIMARY_MODEL=deepseek/deepseek-chat-v3-0324
DEFAULT_PLANNER_MODEL=deepseek/deepseek-r1

# Development-only AES-256 key is supplied by docker-compose.yml if unset.
# For production, provide a unique 32-byte base64 key from a secret manager:
#   openssl rand -base64 32
# HAAS_SECRET_ENCRYPTION_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Provider-neutral OIDC (required for production API identity and tenant bootstrap).
# HAAS_OIDC_ISSUER=https://identity.example.com/
# HAAS_OIDC_AUDIENCE=haas-api
# HAAS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# One-time bootstrap inputs: run `haas-bootstrap-tenant` after migrations, then remove
# these values from the deployment environment. The exact issuer + subject are trusted.
# HAAS_BOOTSTRAP_TENANT_SLUG=acme
# HAAS_BOOTSTRAP_ADMIN_ISSUER=https://identity.example.com/
# HAAS_BOOTSTRAP_ADMIN_SUBJECT=provider-specific-stable-subject

# Optional: password for the development Flower UI (user:password)
FLOWER_BASIC_AUTH=admin:change-me

# Optional endpoints used by plugins/revenue-ops/endpoints/mcp_and_webhooks.json
# BILLING_MCP_URL=https://mcp.billing.example.com/mcp
# BILLING_WEBHOOK_URL=https://billing.example.com/hooks/refund-batches

# Plugin policy (comma-separated plugin ids; identical for API and workers).
# deny always wins; a non-empty allow list is exclusive and also enables plugins that ship "enabled": false.
# PLUGINS_ALLOW=
# PLUGINS_DENY=
# Extra read-only plugin roots (lower precedence than PLUGINS_DIR); mount them in docker-compose.yml too.
# PLUGINS_EXTRA_DIRS=/app/plugins-extra
# Abort startup if any plugin fails to load (default: isolate the plugin and keep serving).
# PLUGINS_STRICT=false

# Tier-1 skill catalog budget in characters (0 = unlimited).
# SKILLS_PROMPT_MAX_CHARS=6000
# Per-tenant skill allowlists as a JSON object; "*" is the default for unlisted tenants.
# TENANT_SKILL_ALLOWLISTS={"fin-ops":["revenue-ops","data-analyst"],"*":["weather","web-research"]}
