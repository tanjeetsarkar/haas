{
  "components": {
    "schemas": {
      "CreateRunRequest": {
        "properties": {
          "max_cost_usd": {
            "default": 0.3,
            "exclusiveMinimum": 0.0,
            "maximum": 10.0,
            "title": "Max Cost Usd",
            "type": "number"
