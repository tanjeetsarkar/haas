{
  "name": "@haas/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for HaaS (Harness-as-a-Service)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "haas",
    "harness",
    "agents",
    "api",
    "sdk"
  ],
  "author": "HaaS Platform Team",
  "license": "Proprietary",
  "dependencies": {
    "eventsource-parser": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}